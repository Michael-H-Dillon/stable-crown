{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sablecrown.example/schemas/world-pack-1.0.json",
  "title": "Sable Crown World Pack 1.0",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "ownerId", "status", "metadata", "premise", "tone", "factions", "locations", "cultures", "history", "characterOptions", "items", "rules", "npcs", "secrets", "scenarioHooks", "aiGuidance", "safetyBoundaries"],
  "$defs": {
    "entry": { "type": "object", "required": ["id", "name", "description"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "name": { "type": "string", "minLength": 2 }, "description": { "type": "string", "minLength": 8 } }, "additionalProperties": false },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "properties": {
    "schemaVersion": { "const": "1.0" }, "id": { "type": "string", "minLength": 3 }, "version": { "type": "integer", "minimum": 1 }, "ownerId": { "type": "string" }, "status": { "enum": ["draft", "validation-error", "ready"] },
    "metadata": { "type": "object", "required": ["title", "tagline", "author", "description", "contentRating"], "properties": { "title": { "type": "string", "minLength": 3 }, "tagline": { "type": "string", "minLength": 3 }, "author": { "type": "string", "minLength": 2 }, "description": { "type": "string", "minLength": 20 }, "contentRating": { "const": "mature-no-explicit-sex" } } },
    "premise": { "type": "string", "minLength": 40 }, "tone": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "factions": { "$ref": "#/$defs/entries" }, "locations": { "$ref": "#/$defs/entries" }, "cultures": { "$ref": "#/$defs/entries" }, "history": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "characterOptions": { "type": "object", "required": ["backgrounds", "strengths", "weaknesses", "motivations"], "properties": { "backgrounds": { "$ref": "#/$defs/entries" }, "strengths": { "$ref": "#/$defs/entries" }, "weaknesses": { "$ref": "#/$defs/entries" }, "motivations": { "$ref": "#/$defs/entries" } } },
    "items": { "$ref": "#/$defs/entries" }, "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "npcs": { "$ref": "#/$defs/entries" }, "secrets": { "$ref": "#/$defs/entries" }, "scenarioHooks": { "$ref": "#/$defs/entries" },
    "aiGuidance": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "safetyBoundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "artwork": { "type": "string" }
  },
  "additionalProperties": false
}
