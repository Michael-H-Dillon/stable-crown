{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sablecrown.example/schemas/world-pack-1.0.json",
  "title": "Sable Crown World Pack 1.0",
  "type": "object",
  "required": [
    "metadata",
    "premise",
    "tone",
    "factions",
    "locations",
    "cultures",
    "history",
    "characterOptions",
    "items",
    "rules",
    "npcs",
    "secrets",
    "scenarioHooks",
    "aiGuidance",
    "safetyBoundaries"
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "awareness": {
      "type": "object",
      "required": [
        "entityId",
        "level",
        "suspicion"
      ],
      "properties": {
        "entityId": {
          "type": "string"
        },
        "level": {
          "enum": [
            "none",
            "suspects",
            "knows"
          ]
        },
        "suspicion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0"
    },
    "id": {
      "type": "string",
      "description": "Legacy optional field; Supabase assigns the saved pack identity."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy optional field; Supabase assigns the next saved version."
    },
    "ownerId": {
      "type": "string",
      "description": "Ignored on upload; ownership comes from the authenticated user."
    },
    "status": {
      "enum": [
        "draft",
        "validation-error",
        "ready"
      ],
      "description": "Ignored on upload; a successful import is ready."
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "tagline",
        "description",
        "contentRating"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "tagline": {
          "type": "string",
          "minLength": 3
        },
        "author": {
          "type": "string",
          "minLength": 2,
          "description": "Optional; defaults to the signed-in player's display name."
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "contentRating": {
          "const": "mature-no-explicit-sex"
        }
      }
    },
    "premise": {
      "type": "string",
      "minLength": 40
    },
    "tone": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "factions": {
      "$ref": "#/$defs/entries"
    },
    "locations": {
      "$ref": "#/$defs/entries"
    },
    "cultures": {
      "$ref": "#/$defs/entries"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "characterOptions": {
      "type": "object",
      "required": [
        "backgrounds",
        "strengths",
        "weaknesses",
        "motivations"
      ],
      "properties": {
        "backgrounds": {
          "$ref": "#/$defs/entries"
        },
        "strengths": {
          "$ref": "#/$defs/entries"
        },
        "weaknesses": {
          "$ref": "#/$defs/entries"
        },
        "motivations": {
          "$ref": "#/$defs/entries"
        }
      }
    },
    "items": {
      "$ref": "#/$defs/entries"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "npcs": {
      "$ref": "#/$defs/entries"
    },
    "secrets": {
      "$ref": "#/$defs/entries"
    },
    "scenarioHooks": {
      "$ref": "#/$defs/entries"
    },
    "aiGuidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "safetyBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "openingScenario": {
      "type": "object",
      "required": [
        "id",
        "title",
        "chapterLabel",
        "narration",
        "startLocationId",
        "startingInventory",
        "memories",
        "unresolvedThreads",
        "sceneFacts",
        "calendar"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "chapterLabel": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "startLocationId": {
          "type": "string"
        },
        "startingInventory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolvedThreads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sceneFacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          }
        },
        "calendar": {
          "type": "object",
          "required": [
            "name",
            "year",
            "day",
            "segment"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "year": {
              "type": "string"
            },
            "day": {
              "type": "integer",
              "minimum": 1
            },
            "segment": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "playerPreset": {
          "type": "object",
          "required": [
            "name",
            "pronouns",
            "backgroundId",
            "strengthId",
            "weaknessId",
            "motivationId"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "pronouns": {
              "type": "string"
            },
            "backgroundId": {
              "type": "string"
            },
            "strengthId": {
              "type": "string"
            },
            "weaknessId": {
              "type": "string"
            },
            "motivationId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "worldEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "earliestDay",
          "latestDay",
          "conditions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "earliestDay": {
            "type": "integer",
            "minimum": 1
          },
          "latestDay": {
            "type": "integer",
            "minimum": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "secretSystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "stakes",
          "initialAwareness",
          "evidenceTypes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "stakes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "initialAwareness": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/awareness"
            }
          },
          "evidenceTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "characterProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "npcId",
          "values",
          "goals",
          "loyalties",
          "persuasion"
        ],
        "properties": {
          "npcId": {
            "type": "string"
          },
          "startingLocation": {
            "type": "object",
            "required": [
              "locationId",
              "confidence",
              "reason"
            ],
            "properties": {
              "locationId": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "confirmed"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "goals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "loyalties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canonBehaviors": {
            "description": "Optional canonical tendencies and precedents used as a flexible baseline, not absolute restrictions.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "persuasion": {
            "type": "object",
            "required": [
              "baseDifficulty",
              "leverage",
              "relationshipThresholds"
            ],
            "properties": {
              "baseDifficulty": {
                "enum": [
                  "easy",
                  "moderate",
                  "hard",
                  "extreme"
                ]
              },
              "leverage": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "relationshipThresholds": {
                "type": "object",
                "required": [
                  "cooperative",
                  "majorRisk"
                ],
                "properties": {
                  "cooperative": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "majorRisk": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "economicProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "backgroundIds",
          "currency",
          "balance",
          "recurringIncome",
          "recurringOutgoings",
          "incomePeriod",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "backgroundIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "currency": {
            "type": "string"
          },
          "balance": {
            "type": "number",
            "minimum": 0
          },
          "recurringIncome": {
            "type": "number",
            "minimum": 0
          },
          "recurringOutgoings": {
            "type": "number",
            "minimum": 0
          },
          "incomePeriod": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "factionEconomicProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "factionId",
          "currency",
          "wealthTier",
          "balance",
          "recurringIncome",
          "recurringOutgoings",
          "incomePeriod",
          "description"
        ],
        "properties": {
          "factionId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "wealthTier": {
            "enum": [
              "very-rich",
              "rich",
              "average",
              "poor",
              "destitute"
            ]
          },
          "balance": {
            "type": "number",
            "minimum": 0
          },
          "recurringIncome": {
            "type": "number",
            "minimum": 0
          },
          "recurringOutgoings": {
            "type": "number",
            "minimum": 0
          },
          "incomePeriod": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artwork": {
      "type": "string"
    }
  },
  "additionalProperties": false
}